{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Data publik anggota Team Senyap Nusantara untuk verifikasi KTA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID Anggota misal TSN-00125" },
        "name": { "type": "string", "description": "Nama lengkap anggota" },
        "division": { "type": "string", "description": "Divisi organisasi" },
        "membershipType": { "type": "string", "description": "Kategori keanggotaan" },
        "region": { "type": "string", "description": "Wilayah atau cabang" },
        "joinDate": { "type": "string", "description": "Tanggal bergabung" },
        "status": { "type": "string", "description": "Status keanggotaan" },
        "photoUrl": { "type": "string", "description": "Foto profil KTA" },
        "verifiedBy": { "type": "string", "description": "Pengurus yang memverifikasi" },
        "verifiedAt": { "type": "string", "description": "Waktu verifikasi" },
        "createdAt": { "type": "string", "description": "Waktu pembuatan record" }
      },
      "required": ["id", "name", "division", "region", "status"]
    },
    "MemberPrivate": {
      "title": "MemberPrivate",
      "description": "Data pribadi sensitif anggota (terlindungi hak akses pengurus)",
      "type": "object",
      "properties": {
        "nik": { "type": "string", "description": "Nomor Induk Kependudukan (NIK)" },
        "phone": { "type": "string", "description": "Nomor WhatsApp/HP" },
        "email": { "type": "string", "description": "Alamat email" },
        "address": { "type": "string", "description": "Alamat domisili" },
        "ktpUrl": { "type": "string", "description": "Foto dokumen KTP" },
        "signatureUrl": { "type": "string", "description": "Tanda tangan digital" },
        "reason": { "type": "string", "description": "Alasan atau motivasi bergabung" },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan Kas Masuk dan Keluar Organisasi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID Transaksi" },
        "date": { "type": "string", "description": "Tanggal transaksi" },
        "type": { "type": "string", "description": "Tipe pemasukan atau pengeluaran" },
        "category": { "type": "string", "description": "Kategori transaksi" },
        "amount": { "type": "number", "description": "Nominal dalam Rupiah" },
        "description": { "type": "string", "description": "Keterangan transaksi" },
        "recordedBy": { "type": "string", "description": "Pencatat transaksi" }
      },
      "required": ["id", "date", "type", "category", "amount", "description"]
    },
    "LegalAidCase": {
      "title": "LegalAidCase",
      "description": "Permohonan Bantuan Hukum Posko LPKSM TSN",
      "type": "object",
      "properties": {
        "ticketNumber": { "type": "string", "description": "Nomor tiket pengaduan" },
        "applicantName": { "type": "string", "description": "Nama pemohon" },
        "phone": { "type": "string", "description": "Nomor kontak pemohon" },
        "category": { "type": "string", "description": "Kategori perkara hukum" },
        "location": { "type": "string", "description": "Lokasi kejadian perkara" },
        "description": { "type": "string", "description": "Uraian kronologi kasus" },
        "status": { "type": "string", "description": "Status tindak lanjut" },
        "submittedAt": { "type": "string", "description": "Waktu pengajuan" }
      },
      "required": ["ticketNumber", "applicantName", "phone", "category", "description", "status"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Konfigurasi identitas organisasi Team Senyap Nusantara",
      "type": "object",
      "properties": {
        "orgName": { "type": "string", "description": "Nama Organisasi" },
        "subTitle": { "type": "string", "description": "Sub-judul / Naungan LPKSM" },
        "heroHeadline": { "type": "string", "description": "Headline banner utama" },
        "heroTagline": { "type": "string", "description": "Slogan" },
        "phoneHotline": { "type": "string", "description": "Nomor kontak hotline" },
        "whatsappNumber": { "type": "string", "description": "Nomor WhatsApp resmi" },
        "email": { "type": "string", "description": "Email resmi" },
        "address": { "type": "string", "description": "Alamat kantor pusat" },
        "legalNumber": { "type": "string", "description": "Nomor SK Kemenkumham / LPKSM" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Catatan audit aktivitas perubahan data oleh pengurus",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID log" },
        "timestamp": { "type": "string", "description": "Waktu aktivitas" },
        "adminEmail": { "type": "string", "description": "Email admin yang bertindak" },
        "adminUid": { "type": "string", "description": "UID admin" },
        "action": { "type": "string", "description": "Tipe tindakan" },
        "targetId": { "type": "string", "description": "ID target data" },
        "details": { "type": "string", "description": "Keterangan rincian aktivitas" }
      },
      "required": ["id", "timestamp", "adminEmail", "action", "details"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Koleksi Berita, Siaran Pers, dan Informasi Publik TSN",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID Berita" },
        "title": { "type": "string", "description": "Judul Berita" },
        "category": { "type": "string", "description": "Kategori Berita" },
        "date": { "type": "string", "description": "Tanggal publikasi" },
        "author": { "type": "string", "description": "Penulis atau redaksi berita" },
        "summary": { "type": "string", "description": "Ringkasan intisari berita" },
        "content": { "type": "string", "description": "Isi lengkap naskah berita" },
        "imageUrl": { "type": "string", "description": "URL foto / sampul ilustrasi berita" }
      },
      "required": ["id", "title", "category", "date", "author", "summary", "content"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Koleksi data profil publik anggota untuk verifikasi KTA resmi"
    },
    "/members/{memberId}/private/data": {
      "schema": "MemberPrivate",
      "description": "Subkoleksi data pribadi sensitif anggota (khusus admin pengurus)"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Koleksi arus kas organisasi (publik baca, tulis khusus admin)"
    },
    "/legalAidCases/{caseId}": {
      "schema": "LegalAidCase",
      "description": "Koleksi permohonan bantuan hukum (input publik, akses daftar khusus admin)"
    },
    "/settings/{configId}": {
      "schema": "SiteConfig",
      "description": "Pengaturan informasi situs dan posko TSN"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Rekam jejak audit aktivitas pengurus"
    },
    "/news/{newsId}": {
      "schema": "NewsItem",
      "description": "Koleksi artikel berita dan publikasi informasi (baca publik, tulis admin)"
    }
  }
}
