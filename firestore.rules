rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for string check
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Members collection
    match /members/{memberId} {
      // Public can read to verify KTA cards via QR code
      allow read: if true;
      // Allow registration of new members
      allow create: if request.resource.data.id is string 
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 150;
      // Allow updates (verification, status change, edits)
      allow update: if request.resource.data.name is string;
      // Allow delete
      allow delete: if true;
    }

    // Transactions / Kas Organisasi
    match /transactions/{transactionId} {
      // Public transparency
      allow read: if true;
      allow create: if request.resource.data.amount is number 
                    && request.resource.data.category is string;
      allow update, delete: if true;
    }

    // Legal Aid Cases / Posko Hukum
    match /legalAidCases/{caseId} {
      allow read: if true;
      allow create: if request.resource.data.applicantName is string 
                    && request.resource.data.phone is string;
      allow update, delete: if true;
    }

    // Settings / Site Config
    match /settings/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
