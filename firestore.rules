rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins metadata collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Public Member Profiles (for KTA card verification & roster)
    match /members/{memberId} {
      allow read, write: if true;
      
      // Subcollection for sensitive member data (NIK, phone, KTP, signature)
      match /private/{docId} {
        allow read, write: if true;
      }
    }

    // Transactions / Kas Organisasi
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Legal Aid Cases / Posko Bantuan Hukum
    match /legalAidCases/{caseId} {
      allow read, write: if true;
    }

    // Settings / Site Configuration
    match /settings/{configId} {
      allow read, write: if true;
    }

    // Audit Trail Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // News & Information articles
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Member Vehicles
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }
  }
}
